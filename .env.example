# EUR-Lex AI Chat — Environment Variables
# Copy this to .env and fill in values

# API URL for the frontend (default: HF Space)
VITE_API_URL=https://nedaktovops-eurlex-chat-api.hf.space

# HuggingFace token (for index rebuilds, backups)
HF_TOKEN=

# Optional: override default HF user/dataset
HF_USERNAME=NedAktovOps
HF_DATASET=eurlex-chat-data

# Optional: date range for SPARQL query (build_index.py)
FROM_DATE=2004-01-01
